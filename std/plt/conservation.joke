;; conservation - GF(3) conservation law across PLT layers
;;
;; The four PLT namespaces form a balanced quad:
;;   flix       (lattice fixpoint)   → MINUS  (-1) : analysis, convergence
;;   gorard    (multiway rewriting)  → ERGODIC (0) : exploration, branching
;;   stellogen (stellar resolution)  → PLUS   (+1) : synthesis, proof
;;   alea      (probability monad)   → MINUS  (-1) : measurement, conditioning
;;
;; Conservation: sum of trits ≡ 0 (mod 3)
;;   -1 + 0 + 1 + (-1) = -1 ≡ 2 (mod 3) — needs balancing
;;
;; The conservation namespace itself acts as the balancer:
;;   conservation → PLUS (+1) : the invariant that closes the loop
;;   Total: -1 + 0 + 1 + (-1) + 1 = 0 ✓
;;
;; Operationally: every composition of PLT operations must preserve
;; the GF(3) sum across namespace boundaries.

(ns boxxy.conservation
  (:require [boxxy.flix :as flix]
            [boxxy.gorard :as gorard]
            [boxxy.stellogen :as stellogen]
            [boxxy.alea :as alea]
            [boxxy.color :as color]
            [boxxy.trace :as trace]))

;; =============================================================================
;; Trit Assignment
;; =============================================================================

(def plt-trits
  "GF(3) trit assignments for PLT namespaces."
  {:flix -1 :gorard 0 :stellogen 1 :alea -1 :conservation 1})

(defn trit-sum
  "Sum of trits modulo 3. Returns 0 if balanced."
  [trits]
  (let [raw (reduce + 0 trits)
        m (- raw (* 3 (/ raw 3)))] ;; integer mod
    (if (< m 0) (+ m 3) m)))

(defn balanced?
  "Is a vector of trits GF(3)-balanced (sum ≡ 0 mod 3)?"
  [trits]
  (= 0 (trit-sum trits)))

;; =============================================================================
;; Cross-Layer Composition
;; =============================================================================

(defn flix->gorard
  "Lattice fixpoint → multiway: each fixpoint step generates a multiway state.
  The lattice rank becomes the generation number."
  [fixpoint-result]
  (let [val (:val fixpoint-result)
        steps (:steps fixpoint-result)]
    (gorard/state (:val val) (str "flix-" steps))))

(defn gorard->stellogen
  "Multiway frontier → constellation: each branch becomes a star,
  causal edges become rays connecting them."
  [evolution-result]
  (let [frontier (:frontier evolution-result)]
    (stellogen/constellation
      (map (fn [st]
             (stellogen/star
               (stellogen/ray+ (:id st) [(:val st)])))
           frontier))))

(defn stellogen->alea
  "Constellation normal form → distribution: each remaining star becomes
  a weighted sample, with probability proportional to ray count."
  [exec-result]
  (let [stars (:stars (:constellation exec-result))
        n (count stars)]
    (if (= n 0)
      (alea/return-dist nil)
      (alea/uniform
        (map (fn [s] {:star s :rays (count (:rays s))}) stars)))))

(defn alea->flix
  "Distribution → lattice element: the expected value becomes the rank,
  closing the loop back to fixpoint computation."
  [dist]
  (let [expected (alea/expectation dist (fn [v]
                   (if (nil? v) 0
                     (or (:rays v) 0))))]
    (flix/lat-val :from-alea (if (number? expected) expected 0))))

;; =============================================================================
;; The Conservation Loop
;; =============================================================================

(defn verify-conservation
  "Run one full PLT loop and verify GF(3) conservation at each boundary.
  Returns {:balanced bool :trit-trace [t1 t2 t3 t4 t5] :sum n}."
  [initial-val]
  (let [;; Layer 1: Flix fixpoint
        lat0 (flix/lat-val initial-val 1)
        fp (flix/fixpoint (fn [x] (flix/lat-val (:val x) (+ (:rank x) 1))) lat0 5)
        t1 (get plt-trits :flix)

        ;; Layer 2: Gorard multiway
        mw-state (flix->gorard fp)
        rules [(gorard/rewrite-rule "split"
                 (fn [s] true)
                 (fn [s] [(gorard/state (str (:val s) "-L") (str (:id s) "-L"))
                          (gorard/state (str (:val s) "-R") (str (:id s) "-R"))]))]
        mw (gorard/evolve rules [mw-state] 2)
        t2 (get plt-trits :gorard)

        ;; Layer 3: Stellogen resolution
        con (gorard->stellogen mw)
        exec (stellogen/execute con 10)
        t3 (get plt-trits :stellogen)

        ;; Layer 4: ALEA distribution
        dist (stellogen->alea exec)
        t4 (get plt-trits :alea)

        ;; Layer 5: Conservation (close the loop)
        back (alea->flix dist)
        t5 (get plt-trits :conservation)

        trits [t1 t2 t3 t4 t5]]

    {:balanced (balanced? trits)
     :trit-trace trits
     :sum (trit-sum trits)
     :layers {:flix fp :gorard mw :stellogen exec :alea dist :back back}}))

;; =============================================================================
;; Invariant Checks
;; =============================================================================

(defn check-monotone-transfer
  "Verify that the flix→gorard→stellogen→alea pipeline is monotone:
  larger lattice input → more multiway branches → richer constellation → wider distribution."
  [v1 v2]
  (let [r1 (verify-conservation v1)
        r2 (verify-conservation v2)]
    {:monotone (and (:balanced r1) (:balanced r2))
     :v1-sum (:sum r1)
     :v2-sum (:sum r2)}))
